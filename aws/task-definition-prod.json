{
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "family": "AwsEcsDeploymentDemo-TaskDefinition-Prod",
    "containerDefinitions": [
        {
            "name": "aws-ecs-deployment-demo",
            "image": "#AWS_ACCOUNT_ID#.dkr.ecr.us-east-1.amazonaws.com/aws-ecs-deployment-demo:#APP_VERSION#",
            "portMappings": [
                {
                    "name": "ngnix-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true
        }
    ],
    "volumes": [],
    "networkMode": "awsvpc",
    "memory": "512",
    "cpu": "256",
    "executionRoleArn": "arn:aws:iam::#AWS_ACCOUNT_ID#:role/ecsTaskExecutionRole"
}